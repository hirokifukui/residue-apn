def ResidueAPN.polG.{u_1} : (R : Type u_1) → [inst : CommRing R] → ℕ → R[X] :=
fun R [CommRing R] s => X ^ 2 ^ s + X + 1
def ResidueAPN.IsBit.{u_1} : {F : Type u_1} → [Field F] → F → Prop :=
fun {F} [Field F] u => u = 0 ∨ u = 1
