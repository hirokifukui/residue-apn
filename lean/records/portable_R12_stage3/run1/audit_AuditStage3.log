def ResidueAPN.IsQuadSupp : ℕ → (ZMod 2)[X] → Prop :=
fun m p => ∀ n ∈ p.support, n = 0 ∨ (∃ i < m, n = 2 ^ i) ∨ ∃ i j, i < j ∧ j < m ∧ n = 2 ^ i + 2 ^ j
def ResidueAPN.kappaOf : ℕ → (ZMod 2)[X] → (ZMod 2)[X] :=
fun m p => ∑ j ∈ Ico 1 m, (monomial j) (p.coeff (1 + 2 ^ j))
def ResidueAPN.linMap.{u_1} : {F : Type u_1} → [inst : Field F] → [CharP F 2] → (ZMod 2)[X] → F → F :=
fun {F} [Field F] [CharP F 2] κ x => κ.sum fun i c => (c2 F) c * x ^ 2 ^ i
@[reducible] def ResidueAPN.c2.{u_2} : (F : Type u_2) → [inst : Field F] → [CharP F 2] → ZMod 2 →+* F :=
fun F [Field F] [CharP F 2] => ZMod.castHom c2._proof_1 F
def ResidueAPN.kerL.{u_1} : {F : Type u_1} →
  [inst : Field F] → [Fintype F] → [DecidableEq F] → [CharP F 2] → (ZMod 2)[X] → Finset F :=
fun {F} [Field F] [Fintype F] [DecidableEq F] [CharP F 2] κ => {x | linMap κ x = 0}
