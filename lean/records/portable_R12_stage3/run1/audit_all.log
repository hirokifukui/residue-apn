def ResidueAPN.polV.{u_1} : (R : Type u_1) → [inst : CommRing R] → ℕ → R[X] :=
fun R [CommRing R] r => ∑ i ∈ range (r - 2), X ^ 2 ^ i
def ResidueAPN.polW.{u_1} : (R : Type u_1) → [inst : CommRing R] → ℕ → R[X] :=
fun R [CommRing R] r => X ^ 2 ^ (r - 2)
def ResidueAPN.polY.{u_1} : (R : Type u_1) → [inst : CommRing R] → ℕ → R[X] :=
fun R [CommRing R] m => X ^ 2 ^ (m - 2)
def ResidueAPN.polZ.{u_1} : (R : Type u_1) → [inst : CommRing R] → ℕ → R[X] :=
fun R [CommRing R] m => X ^ 2 ^ (m - 1)
def ResidueAPN.polD.{u_1} : (R : Type u_1) → [inst : CommRing R] → ℕ → ℕ → R[X] :=
fun R [CommRing R] m r => 1 + polW R r + polY R m
def ResidueAPN.polE.{u_1} : (R : Type u_1) → [inst : CommRing R] → ℕ → ℕ → R[X] :=
fun R [CommRing R] m r => 1 + polV R r + polY R m + polZ R m
def ResidueAPN.polP.{u_1} : (R : Type u_1) → [inst : CommRing R] → ℕ → ℕ → R[X] :=
fun R [CommRing R] m r =>
  polV R r + polW R r + polW R r * polV R r + polW R r * polY R m + polW R r * polZ R m + polY R m * polV R r +
