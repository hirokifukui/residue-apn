fun {F} [Field F] [Fintype F] [DecidableEq F] Q => ∀ (a : F), a ≠ 0 → ∀ (b : F), #{x | ResidueAPN.deriv Q a x = b} ≤ 2
def ResidueAPN.deriv.{u_1} : {F : Type u_1} → [Field F] → (F → F) → F → F → F :=
fun {F} [Field F] Q a x => Q (x + a) + Q x
def ResidueAPN.rep.{u_1} : {F : Type u_1} → [inst : Field F] → [Fintype F] → [DecidableEq F] → (F → F) → F[X] :=
fun {F} [Field F] [Fintype F] [DecidableEq F] f => (Lagrange.interpolate univ id) f
