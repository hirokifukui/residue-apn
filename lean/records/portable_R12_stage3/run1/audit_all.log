fun s => ∑ i ∈ s, 2 ^ i
def ResidueAPN.idx1 : ℕ → Finset (Finset ℕ) :=
fun r => image (fun i => {i}) (range (r - 1))
def ResidueAPN.idx2 : ℕ → Finset (Finset ℕ) :=
fun r => image (fun i => {i, r - 2}) (range (r - 2))
def ResidueAPN.idx3 : ℕ → ℕ → Finset (Finset ℕ) :=
fun m r => image (fun i => {i, m - 2}) (range (r - 2))
def ResidueAPN.idx4 : ℕ → ℕ → Finset (Finset ℕ) :=
fun m r => {{r - 2, m - 2}, {r - 2, m - 1}, {m - 2, m - 1}}
def ResidueAPN.supportIdx : ℕ → ℕ → Finset (Finset ℕ) :=
fun m r => idx1 r ∪ idx2 r ∪ idx3 m r ∪ idx4 m r
def ResidueAPN.suppP : ℕ → ℕ → Finset ℕ :=
